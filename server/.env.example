# Porta do backend Express
PORT=3001
# Origem do frontend Next.js para CORS
CLIENT_URL=http://localhost:3000
# Segredo HMAC para tokens JWT-like (obrigatorio em producao)
AUTH_SECRET=
# Caminho opcional do arquivo SQLite (padrao: server/data/magna.db)
DB_PATH=
# Atraso simulado em desenvolvimento (ms); defina 0 para desativar
MOCK_DELAY_MS=150
